# GLaDOS 签到环境变量模板 (复制为 .env 后填写, run.sh 会自动加载)
# 填入实际 Cookie（多账号用 & 连接）
GLADOS_COOKIES="gld:sess=your_session_cookie; gld:sess.sig=your_signature;"

# 签到域名（可选：逗号分隔，默认 glados.cloud,railgun.info）
# GLADOS_DOMAINS="glados.cloud"

# PushDeer 推送密钥（可选）
PUSHDEER_SENDKEY="your_push_key_here"

# 积分自动兑换策略（可选：plan100, plan200, plan500，默认 plan500）
GLADOS_EXCHANGE_PLAN="plan500"

# 登录浏览器的 navigator.userAgent（可选，签到返回 code 4 时必填）
# GLADOS_USER_AGENT=""

# 是否输出详细响应日志（可选：true/false，默认 false）
GLADOS_VERBOSE="false"
