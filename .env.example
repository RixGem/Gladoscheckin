# GLaDOS 签到环境变量模板
# 填入实际 Cookie（多账号用 & 连接）
COOKIES="koa:sess=your_session_cookie; koa:sess.sig=your_signature;"

# Server酱 / PushDeer 推送密钥（可选）
SENDKEY="your_push_key_here"

# 积分自动兑换策略（可选：plan100, plan200, plan500，默认 plan500）
EXCHANGE_PLAN="plan500"

# 是否输出详细响应日志（可选：true/false，默认 false）
GLADOS_VERBOSE="false"
